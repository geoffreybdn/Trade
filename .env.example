# Copie ce fichier en .env puis remplis-le. Ne partage JAMAIS ce fichier.
# Clés API Binance (Binance > Profil > Gestion des API)
FREQTRADE__EXCHANGE__KEY=
FREQTRADE__EXCHANGE__SECRET=

# Identifiants de l'interface web FreqUI
FREQTRADE__API_SERVER__USERNAME=freqtrader
FREQTRADE__API_SERVER__PASSWORD=change-moi
FREQTRADE__API_SERVER__JWT_SECRET_KEY=change-moi-avec-une-longue-chaine-aleatoire
FREQTRADE__API_SERVER__WS_TOKEN=change-moi-aussi

# Telegram (optionnel)
# FREQTRADE__TELEGRAM__ENABLED=true
# FREQTRADE__TELEGRAM__TOKEN=
# FREQTRADE__TELEGRAM__CHAT_ID=

# Tailscale : accès sécurisé depuis ton téléphone
# https://login.tailscale.com/admin/settings/keys -> "Generate auth key"
TS_AUTHKEY=
